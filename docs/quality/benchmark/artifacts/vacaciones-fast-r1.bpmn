going></bpmn:task><bpmn:serviceTask id="Task_EnviarConfirmacion" name="Enviar confirmación al empleado"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Aprobada" name="Solicitud aprobada"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="Task_EnviarRechazo" name="Enviar aviso de rechazo"><bpmn:incoming>Flow_No</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_Rechazada" name="Solicitud rechazada"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Registrar" /><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registrar" targetRef="Task_Revisar" /><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Revisar" targetRef="Gw_Aprobada" /><bpmn:sequenceFlow id="Flow_Si" name="Sí" sourceRef="Gw_Aprobada" targetRef="Task_Descontar" /><bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gw_Aprobada" targetRef="Task_EnviarRechazo" /><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Descontar" targetRef="Task_EnviarConfirmacion" /><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_EnviarConfirmacion" targetRef="End_Aprobada" /><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_EnviarRechazo" targetRef="End_Rechazada" /></bpmn:process>  <bpmndi:BPMNDiagram id="BPMNDiagram_Collab">
